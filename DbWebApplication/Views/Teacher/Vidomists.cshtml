@model List<DbWebApplication.Models.SessionSubjects>
@*<h3 class="role">@ViewBag.SubjectName</h3>*@

<div class="admin__panel__inner">
    @foreach(var subject in Model)
    {
    <div class="admin__panel__btn__box">
        <a href="@Url.Action("Vidomist", "Teacher", new {teacherId = @ViewBag.teacherId, subjectId = subject.Id})"
           class="admin__panel__btn__text">@subject.SubjectName</a>
    </div>
    }
</div>