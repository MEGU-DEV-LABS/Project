@using System.Security.Claims

<div>
    <ul style="display: flex">
        @if (User.Identity?.IsAuthenticated ?? false)
        {
            <li>
                <span class="nav-link text-dark">
                    Hello @User.FindFirst(ClaimTypes.NameIdentifier)?.Value!
                </span>
            </li>
            <li>
                <form method="post" asp-action="Logout" asp-controller="Auth">
                    <button type="submit" class="nav-link text-dark border-0">Logout</button>
                </form>
            </li>
        }
        else
        {
            <li>
                <a class="nav-link text-dark" asp-action="Login" asp-controller="Auth">Login</a>
            </li>
        }
    </ul>
</div>