@using DbWebApplication.Helpers
@model DbWebApplication.ViewModels.StudentSessionSubjectsViewModel

<style>
        body {
            /*font-family: Arial, sans-serif;
            margin: 20px;*/
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }
        table,
        th,
        td {
            border: 1px solid black;
        }
        th,
        td {
            padding: 8px;
            text-align: left;
        }
        th {
            background-color: #f2f2f2;
        }
        .swiper {
            max-width: 1000px;
            min-height: 800px;
        }

        .container__card {
            max-width: 700px;
            border: 2px solid black;
            padding: 20px;
            margin: 0 auto;
        }
        .header__card {
            text-align: center;
            font-size: 1.125rem;
            font-weight: bold;
            margin-bottom: 1.25rem;
        }
        .subheader__card {
            text-align: center;
            font-size: 1rem;
            font-weight: bold;
            margin-bottom: 1.25rem;
        }
        .content__card {
            display: flex;
            flex-wrap: wrap;
            column-gap: 3px;

            font-size: 0.875rem;
            line-height: 1.6;
        }
        .photo__card img {
            aspect-ratio: 3 / 4; /* Пропорції 3:4 */
            margin-right: 1.25rem;
            border: 1px solid black;
            background: #f2f2f2;
            width: 100%; /* Ширина 100% у межах батьківського контейнера */
            max-width: 6.25rem; /* Максимальна ширина */
            min-height: 8.3125rem; /* Це обмеження ширини */
        }
        .info__card {
            overflow: hidden;
        }
        .signatures__card div {
            margin-bottom: 10px;
        }

        @@media (max-width: 510px) {
            .sub__info__card {
                display: flex;
                flex-wrap: wrap;
                flex-direction: column;
                align-items: center;
            }

            .date__card {
                text-align: center;
            }

            .signatures__card {
                text-align: center;
            }
        }

        .container_test {
            max-width: 1220px;
            padding: 0 10px;
            margin: 0 auto;
        }
        .subheader__test {
            font-size: 16px;
            text-align: center;
            margin-bottom: 10px;
        }

        .header__test {
            text-align: center;
            font-size: 20px;
            font-weight: bold;
        }
        
        .swiper-button-next svg{
            display: none;
        }
        .swiper-button-prev svg{
            display: none;
        }
        
    </style>

    <div class="swiper">
        <div class="swiper-wrapper">
            <div class="swiper-slide">
                <div class="container__card">
                    <div class="header__card">
                        Міністерство освіти і науки України<br />
                        Приватний вищий навчальний заклад<br />
                        «Міжнародний економіко-гуманітарний університет<br />
                        імені академіка Степана Дем’янчука»
                    </div>
                    <div class="subheader__card">
                        ЗАЛІКОВА КНИЖКА<br />
                        СТУДЕНТА СТУПЕНЯ ВИЩОЇ ОСВІТИ «БАКАЛАВР»
                    </div>
                    <div class="content__card">
                        <div class="photo__card">
                            <img src="~/images/photo_2024-12-09_16-08-37.jpg" alt="" />
                        </div>
                        <div class="info__card">
                            <strong>Прізвище, ім’я, по батькові:</strong> @Model.Student.LastName
                            @Model.Student.FirstName @Model.Student.FatherName<br />
                            <strong>Інститут, факультет:</strong> @Model.Student.Specialty?.Faculty?.Name<br />
                        </div>
                    </div>
                </div>
            </div>

            @foreach (var semester in Model.Semesters)
            {
                // ======================
                // ЗАЛІКИ
                // ======================
                <div class="swiper-slide">
                    <div class="container_test">

                        <div class="header__test">
                            @semester.SemesterNumber семестр
                        </div>

                        <div class="subheader__test">Заліки</div>

                        <table>
                            <thead>
                            <tr>
                                <th>№</th>
                                <th>Назва дисципліни</th>
                                <th>Години</th>
                                <th>Кредити</th>
                                <th>Викладач</th>
                                <th>Оцінка</th>
                                <th>Бали</th>
                                <th>ECTS</th>
                            </tr>
                            </thead>

                            <tbody>
                            @{
                                int index = 1;
                            }

                            @foreach (var subject in semester.ZalikSubjects)
                            {
                                <tr>
                                    <td>@index</td>
                                    <td>@subject.SubjectName</td>
                                    <td>@subject.Hours</td>
                                    <td>@subject.Credits</td>
                                    <td>
                                        @subject.Teacher?.LastName
                                        @subject.Teacher?.FirstName[0].
                                        @subject.Teacher?.FatherName[0].
                                    </td>

                                    @if (subject.Points != null)
                                    {
                                        <td>@GradeHelper.NationalGrade(subject.Points.Value)</td>
                                        <td>@subject.Points</td>
                                        <td>@GradeHelper.ECTS_Grade(subject.Points.Value)</td>
                                    }
                                    else
                                    {
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                    }
                                </tr>

                                index++;
                            }
                            </tbody>
                        </table>
                    </div>
                </div>


                // ======================
                // ЕКЗАМЕНИ
                // ======================
                <div class="swiper-slide">
                    <div class="container_test">

                        <div class="header__test">
                            @semester.SemesterNumber семестр
                        </div>

                        <div class="subheader__test">Екзамени</div>

                        <table>
                            <thead>
                            <tr>
                                <th>№</th>
                                <th>Назва дисципліни</th>
                                <th>Години</th>
                                <th>Кредити</th>
                                <th>Викладач</th>
                                <th>Оцінка</th>
                                <th>Бали</th>
                                <th>ECTS</th>
                            </tr>
                            </thead>

                            <tbody>
                            @{
                                int index2 = 1;
                            }

                            @foreach (var subject in semester.ExamSubjects)
                            {
                                <tr>
                                    <td>@index2</td>
                                    <td>@subject.SubjectName</td>
                                    <td>@subject.Hours</td>
                                    <td>@subject.Credits</td>
                                    <td>
                                        @subject.Teacher?.LastName
                                        @subject.Teacher?.FirstName[0].
                                        @subject.Teacher?.FatherName[0].
                                    </td>

                                    @if (subject.Points != null)
                                    {
                                        <td>@GradeHelper.NationalGrade(subject.Points.Value)</td>
                                        <td>@subject.Points</td>
                                        <td>@GradeHelper.ECTS_Grade(subject.Points.Value)</td>
                                    }
                                    else
                                    {
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                    }
                                </tr>

                                index2++;
                            }
                            </tbody>
                        </table>
                    </div>
                </div>
            }

        </div>
        <div class="qwe2">
            <div class="swiper-button-prev"></div>
            <div class="swiper-button-next"></div>
        </div>
    </div>
    
